<?xml version="1.0"?>
<Devices>
    <Device type="sensor" subType="kSensorDeviceSubType.Motion" id="protectCamera">
        <Name>Protect Camera</Name>
        <ConfigUI>
            <Field id="cameraIdLabel" type="label">
                <Label>Select the UniFi Protect camera this device tracks. The list is populated live from your Protect controller.</Label>
            </Field>
            <Field id="cameraId" type="menu">
                <Label>Camera:</Label>
                <List class="self" method="getCameraList" dynamicReload="true"/>
            </Field>
            <Field id="audioCountsAsActivity" type="checkbox" defaultValue="true">
                <Label>Audio counts as activity:</Label>
                <Description>Speech or a baby crying turns the device on, like motion</Description>
            </Field>
            <Field id="audioCountsAsActivityHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
                <Label>With this checked, the device on/off state (what a "Device turned on" trigger watches) goes on for motion, speech, or a baby crying. Unchecked, it tracks motion only. A smoke or CO alarm sound never turns it on either way - use their own states.</Label>
            </Field>
            <Field id="SupportsOnState" type="checkbox" defaultValue="true" hidden="true">
                <Label/>
            </Field>
            <Field id="SupportsSensorValue" type="checkbox" defaultValue="false" hidden="true">
                <Label/>
            </Field>
            <Field id="SupportsStatusRequest" type="checkbox" defaultValue="true" hidden="true">
                <Label/>
            </Field>
        </ConfigUI>
        <States>
            <State id="motionDetected">
                <ValueType boolType="OnOff">Boolean</ValueType>
                <TriggerLabel>Motion Detected</TriggerLabel>
                <ControlPageLabel>Motion Detected</ControlPageLabel>
            </State>
            <State id="personDetected">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Person Detected</TriggerLabel>
                <ControlPageLabel>Person Detected</ControlPageLabel>
            </State>
            <State id="vehicleDetected">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Vehicle Detected</TriggerLabel>
                <ControlPageLabel>Vehicle Detected</ControlPageLabel>
            </State>
            <State id="animalDetected">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Animal Detected</TriggerLabel>
                <ControlPageLabel>Animal Detected</ControlPageLabel>
            </State>
            <State id="audioDetected">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Audio Detected</TriggerLabel>
                <ControlPageLabel>Audio Detected</ControlPageLabel>
            </State>
            <State id="speechDetected">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Speech Detected</TriggerLabel>
                <ControlPageLabel>Speech Detected</ControlPageLabel>
            </State>
            <State id="babyCryDetected">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Baby Cry Detected</TriggerLabel>
                <ControlPageLabel>Baby Cry Detected</ControlPageLabel>
            </State>
            <State id="smokeAlarmDetected">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Smoke Alarm Sound Detected</TriggerLabel>
                <ControlPageLabel>Smoke Alarm Sound Detected</ControlPageLabel>
            </State>
            <State id="coAlarmDetected">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>CO Alarm Sound Detected</TriggerLabel>
                <ControlPageLabel>CO Alarm Sound Detected</ControlPageLabel>
            </State>
            <State id="lastMotion">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Motion</TriggerLabel>
                <ControlPageLabel>Last Motion</ControlPageLabel>
            </State>
            <State id="lastDetectTypes">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Detect Types</TriggerLabel>
                <ControlPageLabel>Last Detect Types</ControlPageLabel>
            </State>
            <State id="lastAudio">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Audio</TriggerLabel>
                <ControlPageLabel>Last Audio</ControlPageLabel>
            </State>
            <State id="lastAudioTypes">
                <ValueType>String</ValueType>
                <TriggerLabel>Last Audio Types</TriggerLabel>
                <ControlPageLabel>Last Audio Types</ControlPageLabel>
            </State>
            <State id="cameraState">
                <ValueType>String</ValueType>
                <TriggerLabel>Camera State</TriggerLabel>
                <ControlPageLabel>Camera State</ControlPageLabel>
            </State>
            <State id="cameraModel">
                <ValueType>String</ValueType>
                <TriggerLabel>Camera Model</TriggerLabel>
                <ControlPageLabel>Camera Model</ControlPageLabel>
            </State>
            <State id="videoMode">
                <ValueType>String</ValueType>
                <TriggerLabel>Video Mode</TriggerLabel>
                <ControlPageLabel>Video Mode</ControlPageLabel>
            </State>
            <State id="hdrType">
                <ValueType>String</ValueType>
                <TriggerLabel>HDR Mode</TriggerLabel>
                <ControlPageLabel>HDR Mode</ControlPageLabel>
            </State>
            <State id="micEnabled">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Microphone Enabled</TriggerLabel>
                <ControlPageLabel>Microphone Enabled</ControlPageLabel>
            </State>
            <State id="micVolume">
                <ValueType>Integer</ValueType>
                <TriggerLabel>Microphone Volume</TriggerLabel>
                <ControlPageLabel>Microphone Volume</ControlPageLabel>
            </State>
            <State id="ledEnabled">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Status LED Enabled</TriggerLabel>
                <ControlPageLabel>Status LED Enabled</ControlPageLabel>
            </State>
            <State id="osdNameEnabled">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>OSD Name Enabled</TriggerLabel>
                <ControlPageLabel>OSD Name Enabled</ControlPageLabel>
            </State>
            <State id="osdDateEnabled">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>OSD Date Enabled</TriggerLabel>
                <ControlPageLabel>OSD Date Enabled</ControlPageLabel>
            </State>
            <State id="connected">
                <ValueType>Boolean</ValueType>
                <TriggerLabel>Event Socket Connected</TriggerLabel>
                <ControlPageLabel>Event Socket Connected</ControlPageLabel>
            </State>
            <State id="snapshotPath">
                <ValueType>String</ValueType>
                <TriggerLabel>Snapshot Path</TriggerLabel>
                <ControlPageLabel>Snapshot Path</ControlPageLabel>
            </State>
        </States>
    </Device>
</Devices>
