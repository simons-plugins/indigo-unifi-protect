    <!-- Issue #8: Protect NVR/console arm state. Live-verified 2026-08-31
    on 7.2.105 (unlike sensors/lights/chimes) - GET /nvrs returns a real
    single object with `armMode`, `type`, `guid`, `mac`, none of which are
    in the OpenAPI spec. No device selection: there is exactly one NVR. -->
    <Device type="custom" id="protectNvr">
        <Name>Protect NVR</Name>
        <ConfigUI>
            <Field id="nvrHelp" type="label">
