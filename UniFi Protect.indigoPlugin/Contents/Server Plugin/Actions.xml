<?xml version="1.0"?>
<Actions>
    <Action id="takeSnapshot" deviceFilter="self.protectCamera" uiPath="DeviceActions">
        <Name>Take Snapshot</Name>
        <CallbackMethod>takeSnapshot</CallbackMethod>
    </Action>

    <Action id="setStatusLed" deviceFilter="self.protectCamera" uiPath="DeviceActions">
        <Name>Set Status LED</Name>
        <CallbackMethod>setStatusLed</CallbackMethod>
        <ConfigUI>
            <Field id="mode" type="menu" defaultValue="on">
                <Label>Status LED:</Label>
                <List>
                    <Option value="on">On</Option>
                    <Option value="off">Off</Option>
                    <Option value="toggle">Toggle</Option>
                </List>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="setOsdOverlay" deviceFilter="self.protectCamera" uiPath="DeviceActions">
        <Name>Set OSD Overlay</Name>
        <CallbackMethod>setOsdOverlay</CallbackMethod>
        <ConfigUI>
            <Field id="showName" type="menu" defaultValue="unchanged">
                <Label>Show camera name:</Label>
                <List>
                    <Option value="unchanged">Unchanged</Option>
                    <Option value="on">On</Option>
                    <Option value="off">Off</Option>
                </List>
            </Field>
            <Field id="showDate" type="menu" defaultValue="unchanged">
                <Label>Show date:</Label>
                <List>
                    <Option value="unchanged">Unchanged</Option>
                    <Option value="on">On</Option>
                    <Option value="off">Off</Option>
                </List>
            </Field>
            <Field id="showLogo" type="menu" defaultValue="unchanged">
                <Label>Show logo:</Label>
                <List>
                    <Option value="unchanged">Unchanged</Option>
                    <Option value="on">On</Option>
                    <Option value="off">Off</Option>
                </List>
            </Field>
            <Field id="overlayLocation" type="menu" defaultValue="unchanged">
                <Label>Overlay location:</Label>
                <List>
                    <Option value="unchanged">Unchanged</Option>
                    <Option value="topLeft">Top left</Option>
                    <Option value="topMiddle">Top middle</Option>
                    <Option value="topRight">Top right</Option>
                    <Option value="bottomLeft">Bottom left</Option>
                    <Option value="bottomMiddle">Bottom middle</Option>
                    <Option value="bottomRight">Bottom right</Option>
                </List>
            </Field>
            <Field id="overlayHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
                <Label>Only the fields you change from "Unchanged" are sent. Leaving everything unchanged is rejected - there would be nothing to do.</Label>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="setVideoMode" deviceFilter="self.protectCamera" uiPath="DeviceActions">
        <Name>Set Video Mode</Name>
        <CallbackMethod>setVideoMode</CallbackMethod>
        <ConfigUI>
            <Field id="videoMode" type="menu" defaultValue="">
                <Label>Video mode:</Label>
                <List class="self" method="getVideoModeList" dynamicReload="true"/>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="setHdrMode" deviceFilter="self.protectCamera" uiPath="DeviceActions">
        <Name>Set HDR Mode</Name>
        <CallbackMethod>setHdrMode</CallbackMethod>
        <ConfigUI>
            <Field id="hdrType" type="menu" defaultValue="auto">
                <Label>HDR mode:</Label>
                <List>
                    <Option value="auto">Auto</Option>
                    <Option value="on">On</Option>
                    <Option value="off">Off</Option>
                </List>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="setMicVolume" deviceFilter="self.protectCamera" uiPath="DeviceActions">
        <Name>Set Microphone Volume</Name>
        <CallbackMethod>setMicVolume</CallbackMethod>
        <ConfigUI>
            <Field id="micVolume" type="textfield" defaultValue="50">
                <Label>Microphone volume (0-100):</Label>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="ptzGotoPreset" deviceFilter="self.protectCamera" uiPath="DeviceActions">
        <Name>PTZ: Go To Preset</Name>
        <CallbackMethod>ptzGotoPreset</CallbackMethod>
        <ConfigUI>
            <Field id="slot" type="menu" defaultValue="0">
                <Label>Preset:</Label>
                <List>
                    <Option value="0">Preset 1 (slot 0)</Option>
                    <Option value="1">Preset 2 (slot 1)</Option>
                    <Option value="2">Preset 3 (slot 2)</Option>
                    <Option value="3">Preset 4 (slot 3)</Option>
                    <Option value="4">Preset 5 (slot 4)</Option>
                </List>
            </Field>
            <Field id="ptzHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
                <Label>Protect's own UI numbers presets 1-5; the API slot is 0-4, hence the offset above. Fire-and-forget: the API offers no position readback. On a non-PTZ camera the controller refuses the command.</Label>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="ptzPatrolStart" deviceFilter="self.protectCamera" uiPath="DeviceActions">
        <Name>PTZ: Start Patrol</Name>
        <CallbackMethod>ptzPatrolStart</CallbackMethod>
        <ConfigUI>
            <Field id="slot" type="menu" defaultValue="0">
                <Label>Patrol:</Label>
                <List>
                    <Option value="0">Patrol 1 (slot 0)</Option>
                    <Option value="1">Patrol 2 (slot 1)</Option>
                    <Option value="2">Patrol 3 (slot 2)</Option>
                    <Option value="3">Patrol 4 (slot 3)</Option>
                    <Option value="4">Patrol 5 (slot 4)</Option>
                </List>
            </Field>
            <Field id="ptzHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
                <Label>Protect's own UI numbers patrols 1-5; the API slot is 0-4, hence the offset above. Fire-and-forget: the API offers no position readback. On a non-PTZ camera the controller refuses the command.</Label>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="ptzPatrolStop" deviceFilter="self.protectCamera" uiPath="DeviceActions">
        <Name>PTZ: Stop Patrol</Name>
        <CallbackMethod>ptzPatrolStop</CallbackMethod>
    </Action>

    <Action id="refreshCameras">
        <Name>Refresh Cameras</Name>
        <CallbackMethod>refreshCameras</CallbackMethod>
    </Action>

    <Action id="triggerAlarmWebhook">
        <Name>Trigger Alarm Manager Webhook</Name>
        <CallbackMethod>triggerAlarmWebhook</CallbackMethod>
        <ConfigUI>
            <Field id="webhookId" type="textfield">
                <Label>Webhook trigger ID:</Label>
            </Field>
            <Field id="webhookHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
                <Label>The Alarm Manager alarm's trigger ID (Protect > Alarm Manager > alarm > Webhook trigger). Indigo variable substitution (%%v:12345%%) is supported.</Label>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="refreshStreamUrls" deviceFilter="self.protectCamera" uiPath="DeviceActions">
        <Name>Refresh Stream URLs</Name>
        <CallbackMethod>refreshStreamUrls</CallbackMethod>
    </Action>

    <Action id="deleteStreamUrls" deviceFilter="self.protectCamera" uiPath="DeviceActions">
        <Name>Delete Stream URLs</Name>
        <CallbackMethod>deleteStreamUrls</CallbackMethod>
        <ConfigUI>
            <Field id="high" type="checkbox" defaultValue="false">
                <Label>High:</Label>
            </Field>
            <Field id="medium" type="checkbox" defaultValue="false">
                <Label>Medium:</Label>
            </Field>
            <Field id="low" type="checkbox" defaultValue="false">
                <Label>Low:</Label>
            </Field>
            <Field id="package" type="checkbox" defaultValue="false">
                <Label>Package:</Label>
            </Field>
            <Field id="deleteStreamHelp" type="label" fontSize="small" fontColor="darkgray" alignWithControl="true">
                <Label>Removes the selected RTSPS streams on the controller. Anything else using those URLs (HomeKit, Scrypted, a viewer) will lose them. Streams are never deleted automatically.</Label>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="setLightLevel" deviceFilter="self.protectLight" uiPath="DeviceActions">
        <Name>Set LED Level</Name>
        <CallbackMethod>setLightLevel</CallbackMethod>
        <ConfigUI>
            <Field id="ledLevel" type="textfield" defaultValue="3">
                <Label>LED level (1-6):</Label>
            </Field>
        </ConfigUI>
    </Action>

    <Action id="setChimeVolume" deviceFilter="self.protectChime" uiPath="DeviceActions">
        <Name>Set Chime Volume</Name>
        <CallbackMethod>setChimeVolume</CallbackMethod>
        <ConfigUI>
            <Field id="volume" type="textfield" defaultValue="50">
                <Label>Ring volume (0-100):</Label>
            </Field>
        </ConfigUI>
    </Action>
</Actions>
